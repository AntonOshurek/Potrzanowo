---
//STYLES
import './main.scss';
//COMPONENTS
import TextBlock from '../../../shared/text-block/text-block.astro';
import ImageBgBlock from '../../../shared/image-bg-block/image-bg-block.astro';
import InvestFilesTable from '../invest-files-table/invest-files-table.astro';
//LIBS
import { mustGetEntry } from '../../../shared/content/must-get-entry';

const [
	banner,
	description,
	imageBgBlock2,
	imageBgBlock3,
	imageBgBlock6,
	imageBgBlock7,
	view1,
	view2,
	view3,
	imageBgBlockProjection0,
	imageBgBlockProjection1,
] = await Promise.all([
	mustGetEntry('imageBlocks', 'investment-banner'),
	mustGetEntry('textBlocks', 'investment-description'),
	mustGetEntry('imageBlocks', 'potrzanowo-2'),
	mustGetEntry('imageBlocks', 'potrzanowo-3'),
	mustGetEntry('imageBlocks', 'potrzanowo-6'),
	mustGetEntry('imageBlocks', 'potrzanowo-7'),
	mustGetEntry('imageBlocks', 'widok-1'),
	mustGetEntry('imageBlocks', 'widok-2'),
	mustGetEntry('imageBlocks', 'widok-3'),
	mustGetEntry('imageBlocks', 'zrzut-0'),
	mustGetEntry('imageBlocks', 'zrzut-1'),
]);
---

<main class="main">
	<ImageBgBlock
		imagePath={banner.data.imagePath}
		title={banner.data.blockTitle}
		alt={banner.data.imageAlt}
	/>

	<TextBlock data={description} />

	<ImageBgBlock
		imagePath={imageBgBlock2.data.imagePath}
		alt={imageBgBlock2.data.imageAlt}
		title={imageBgBlock2.data.blockTitle}
	/>

	<ImageBgBlock
		imagePath={imageBgBlock3.data.imagePath}
		alt={imageBgBlock3.data.imageAlt}
		title={imageBgBlock3.data.blockTitle}
	/>

	<div class="container-with-paddings">
		<ImageBgBlock
			imagePath={imageBgBlockProjection0.data.imagePath}
			alt={imageBgBlockProjection0.data.imageAlt}
			title={imageBgBlockProjection0.data.blockTitle}
			showTitle={true}
		/>

		<ImageBgBlock
			imagePath={imageBgBlockProjection1.data.imagePath}
			alt={imageBgBlockProjection1.data.imageAlt}
			title={imageBgBlockProjection1.data.blockTitle}
			showTitle={true}
		/>
	</div>

	<ImageBgBlock
		imagePath={view1.data.imagePath}
		alt={view1.data.imageAlt}
		title={view1.data.blockTitle}
	/>

	<ImageBgBlock
		imagePath={view2.data.imagePath}
		alt={view2.data.imageAlt}
		title={view2.data.blockTitle}
	/>

	<ImageBgBlock
		imagePath={view3.data.imagePath}
		alt={view3.data.imageAlt}
		title={view3.data.blockTitle}
	/>


	<ImageBgBlock
		imagePath={imageBgBlock6.data.imagePath}
		alt={imageBgBlock6.data.imageAlt}
		title={imageBgBlock6.data.blockTitle}
	/>

	<InvestFilesTable />

	<ImageBgBlock
		imagePath={imageBgBlock7.data.imagePath}
		alt={imageBgBlock7.data.imageAlt}
		title={imageBgBlock7.data.blockTitle}
	/>
</main>
