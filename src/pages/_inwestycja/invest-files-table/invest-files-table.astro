---
import { render } from 'astro:content';
//STYLES
import './invest-files-table.scss';
//LIBS
import { mustGetEntry } from '../../../shared/content/must-get-entry';

const [Table] = await Promise.all([mustGetEntry('tables', 'files-table')]);

const { Content } = await render(Table);
---

<section class="invest-files-table">
	<div class="invest-files-table__wrap container">
		<Content />
	</div>
</section>
