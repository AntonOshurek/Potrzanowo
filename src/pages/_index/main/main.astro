---
//STYLES
import './main.scss';
//COMPONENTS
import IndexLink from '../index-link/index-link.astro';
import { mustGetEntry } from '../../../shared/content/must-get-entry';

//CONTENT
const [investmentlink, investmentlink2, locationlink, activitylink] = await Promise.all([
	mustGetEntry('indexPageLinks', 'index-link-to-investment'),
	mustGetEntry('indexPageLinks', 'index-link-to-investment-2'),
	mustGetEntry('indexPageLinks', 'index-link-to-location'),
	mustGetEntry('indexPageLinks', 'index-link-to-activity'),
]);
---

<main class="main">
	<IndexLink data={investmentlink} />
	<IndexLink data={investmentlink2} />
	<IndexLink data={locationlink} />
	<IndexLink data={activitylink} />
</main>
